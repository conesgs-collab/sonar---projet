# --self-audit in sonar_master.sh fails hard on any CRLF byte in the script
# (`grep -q $'\r'`). Git for Windows defaults to core.autocrlf=true, which
# would otherwise convert this file to CRLF in the working tree on checkout
# and silently break that check. Force LF regardless of the local/global
# autocrlf setting.
*.sh text eol=lf
hooks/pre-commit text eol=lf
# Diagnostic intelligent : les regles et les scenarios de faits sont lus par
# awk (et deployes tels quels sur la cle, lue sous Linux). Un CR en fin de ligne
# fausserait les comparaisons ("uefi\r" != "uefi").
tools/diag_rules.txt text eol=lf
tests/diag/*.facts text eol=lf
*.awk text eol=lf
tools/client_templates.txt text eol=lf
